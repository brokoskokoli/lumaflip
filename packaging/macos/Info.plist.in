<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>de</string>
  <!-- UI languages (SPEC 4.16, F-I18N-02): macOS offers them as per-app language; the
       matching <lang>.lproj folders hold the localized texts below (InfoPlist.strings). -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>de</string><string>en</string><string>fr</string><string>es</string><string>it</string>
    <string>pt-BR</string><string>pt-PT</string><string>nl</string><string>pl</string><string>sv</string>
    <string>da</string><string>nb</string><string>fi</string><string>cs</string><string>ja</string>
    <string>zh-Hans</string><string>zh-Hant</string><string>ko</string>
  </array>
  <key>CFBundleAllowMixedLocalizations</key><true/>
  <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
  <key>CFBundleIdentifier</key><string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
  <key>CFBundleDisplayName</key><string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
  <key>CFBundleVersion</key><string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
  <key>CFBundleIconFile</key><string>${MACOSX_BUNDLE_ICON_FILE}</string>
  <key>NSHumanReadableCopyright</key><string>${MACOSX_BUNDLE_COPYRIGHT}</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.photography</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <!-- Sparkle (F-MAC-08): feed + EdDSA key, only in builds with LF_SPARKLE_PUBLIC_KEY
       (src/CMakeLists.txt). No SUEnableAutomaticChecks: Sparkle asks on the second launch. -->
  ${LF_SPARKLE_PLIST_ENTRIES}
  <key>NSAppleEventsUsageDescription</key>
  <string>Lumaflip fragt auf Wunsch das vorderste Finder-Fenster nach seiner Sortierung, damit die Bilder in derselben Reihenfolge angezeigt werden.</string>
  <!-- TCC prompts (SPEC 10.2): reading the folder of the opened image -->
  <key>NSDesktopFolderUsageDescription</key>
  <string>Lumaflip liest den Ordner des geöffneten Bildes, damit du mit den Pfeiltasten blättern kannst.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Lumaflip liest den Ordner des geöffneten Bildes, damit du mit den Pfeiltasten blättern kannst.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Lumaflip liest den Ordner des geöffneten Bildes, damit du mit den Pfeiltasten blättern kannst.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Lumaflip liest den Ordner des geöffneten Bildes, damit du mit den Pfeiltasten blättern kannst.</string>
  <key>NSNetworkVolumesUsageDescription</key>
  <string>Lumaflip liest den Ordner des geöffneten Bildes, damit du mit den Pfeiltasten blättern kannst.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Bild</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Default</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.jpeg</string><string>public.png</string><string>com.compuserve.gif</string>
        <string>public.tiff</string><string>com.microsoft.bmp</string><string>org.webmproject.webp</string>
        <string>public.heic</string><string>public.heif</string><string>public.avif</string>
        <string>public.jpeg-xl</string><string>public.camera-raw-image</string><string>com.adobe.raw-image</string>
        <string>com.adobe.photoshop-image</string><string>com.ilm.openexr-image</string><string>public.radiance</string>
        <string>public.jpeg-2000</string><string>com.truevision.tga-image</string><string>com.microsoft.ico</string>
        <string>com.apple.icns</string><string>public.svg-image</string><string>public.mpo-image</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Bild (sonstige)</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>public.image</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Ordner</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>public.folder</string></array>
    </dict>
    <!-- F-OPEN-10 (M4): archives and PDF documents, browsed like a folder. Alternate only:
         "Öffnen mit" offers Lumaflip, the default app (Archive Utility, Preview) stays. -->
    <dict>
      <key>CFBundleTypeName</key><string>Comic-Archiv</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.brokoskokoli.lumaflip.cbz</string><string>io.github.brokoskokoli.lumaflip.cbr</string>
        <string>io.github.brokoskokoli.lumaflip.cb7</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Archiv</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.zip-archive</string><string>com.rarlab.rar-archive</string><string>org.7-zip.7-zip-archive</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>PDF-Dokument</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>com.adobe.pdf</string></array>
    </dict>
  </array>
  <!-- F-MAC-07 (M4): Services menu entry "In Lumaflip öffnen" for files in other apps (Finder);
       the title is localized in <lang>.lproj/ServicesMenu.strings. Handled by
       app/MacIntegration_mac.mm (NSApp.servicesProvider, openInLumaflip:userData:error:). -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key><dict><key>default</key><string>In Lumaflip öffnen</string></dict>
      <key>NSMessage</key><string>openInLumaflip</string>
      <key>NSPortName</key><string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
      <key>NSRequiredContext</key><dict/>
      <key>NSSendFileTypes</key>
      <array>
        <string>public.image</string><string>public.folder</string><string>public.zip-archive</string>
        <string>com.rarlab.rar-archive</string><string>org.7-zip.7-zip-archive</string><string>com.adobe.pdf</string>
      </array>
    </dict>
  </array>
  <!-- Formats a Lumaflip backend decodes but macOS has no type for (SPEC 10.4).
       WBMP: Qt image plugin. (QOI, KRA, ORA … follow with their backends in M3.) -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <!-- F-OPEN-10: archive types macOS may not know (RAR, 7z) and the comic book variants. -->
    <dict>
      <key>UTTypeIdentifier</key><string>com.rarlab.rar-archive</string>
      <key>UTTypeDescription</key><string>RAR-Archiv</string>
      <key>UTTypeConformsTo</key><array><string>public.archive</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>rar</string></array>
        <key>public.mime-type</key><array><string>application/vnd.rar</string><string>application/x-rar-compressed</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>org.7-zip.7-zip-archive</string>
      <key>UTTypeDescription</key><string>7-Zip-Archiv</string>
      <key>UTTypeConformsTo</key><array><string>public.archive</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>7z</string></array>
        <key>public.mime-type</key><array><string>application/x-7z-compressed</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>io.github.brokoskokoli.lumaflip.cbz</string>
      <key>UTTypeDescription</key><string>Comic-Archiv (ZIP)</string>
      <key>UTTypeConformsTo</key><array><string>public.zip-archive</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>cbz</string></array>
        <key>public.mime-type</key><array><string>application/vnd.comicbook+zip</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>io.github.brokoskokoli.lumaflip.cbr</string>
      <key>UTTypeDescription</key><string>Comic-Archiv (RAR)</string>
      <key>UTTypeConformsTo</key><array><string>com.rarlab.rar-archive</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>cbr</string></array>
        <key>public.mime-type</key><array><string>application/vnd.comicbook-rar</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>io.github.brokoskokoli.lumaflip.cb7</string>
      <key>UTTypeDescription</key><string>Comic-Archiv (7z)</string>
      <key>UTTypeConformsTo</key><array><string>org.7-zip.7-zip-archive</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>cb7</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>org.wapforum.wbmp</string>
      <key>UTTypeDescription</key><string>WBMP-Bild</string>
      <key>UTTypeConformsTo</key><array><string>public.image</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>wbmp</string></array>
        <key>public.mime-type</key><array><string>image/vnd.wap.wbmp</string></array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
