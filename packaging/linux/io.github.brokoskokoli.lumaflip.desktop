[Desktop Entry]
Type=Application
Name=Lumaflip
GenericName=Image Viewer
GenericName[de]=Bildbetrachter
GenericName[fr]=Visionneuse d'images
GenericName[es]=Visor de imágenes
GenericName[it]=Visualizzatore di immagini
GenericName[nl]=Afbeeldingsviewer
Comment=Flip through a whole folder of photos without waiting
Comment[de]=Einen ganzen Bilderordner ohne Wartezeit durchblättern
Exec=lumaflip %F
TryExec=lumaflip
Icon=io.github.brokoskokoli.lumaflip
Terminal=false
StartupNotify=true
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;
Keywords=image;photo;picture;viewer;raw;heic;avif;jxl;
Keywords[de]=Bild;Foto;Betrachter;Raw;
MimeType=image/jpeg;image/png;image/gif;image/tiff;image/bmp;image/webp;image/heic;image/heif;image/avif;image/jxl;image/svg+xml;image/x-exr;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-qoi;image/x-xcf;image/vnd.adobe.photoshop;image/x-pcx;image/x-sgi;image/x-tga;image/x-icon;image/vnd.microsoft.icon;image/x-dcraw;image/x-canon-cr2;image/x-canon-cr3;image/x-canon-crw;image/x-nikon-nef;image/x-nikon-nrw;image/x-sony-arw;image/x-sony-sr2;image/x-sony-srf;image/x-adobe-dng;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-pentax-pef;image/x-samsung-srw;image/openraster;application/x-krita;application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/zip;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-7z-compressed;application/x-cb7;application/pdf;
